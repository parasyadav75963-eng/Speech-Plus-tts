<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212">
<LinearLayout android:id="@+id/headerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:orientation="horizontal" android:padding="16dp" android:background="#1E1E1E" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Speech Plus TTS" android:textColor="#00E676" android:textSize="22sp" android:textStyle="bold"/><ImageButton android:id="@+id/btnNotificationCenter" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_popup_reminder" android:tint="#00E676" android:background="?attr/selectableItemBackground"/><ImageButton android:id="@+id/btnVoiceSearch" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_btn_speak_now" android:tint="#FFFFFF" android:background="?attr/selectableItemBackground"/></LinearLayout>
<LinearLayout android:id="@+id/searchLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/headerLayout" android:padding="8dp"><EditText android:id="@+id/edtSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Search..." android:textColor="#FFFFFF" android:textColorHint="#AAAAAA"/><ImageButton android:id="@+id/btnClearSearch" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:visibility="gone"/></LinearLayout>
<HorizontalScrollView android:id="@+id/bottomTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:background="#2C2C2C" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp"><Button android:id="@+id/btnTabHome" android:text="HOME" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#00E676" android:textColor="#FFFFFF" android:layout_marginEnd="4dp"/><Button android:id="@+id/btnTabModes" android:text="MODES" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/><Button android:id="@+id/btnTabLanguages" android:text="LANGUAGES" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/><Button android:id="@+id/btnTabVoices" android:text="VOICES" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/><Button android:id="@+id/btnTabAdvanced" android:text="ADVANCED" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/><Button android:id="@+id/btnTabMore" android:text="MORE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#455A64" android:textColor="#B0BEC5"/></LinearLayout></HorizontalScrollView>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/searchLayout" android:layout_above="@id/bottomTabs">
<!-- ================= 1. HOME TAB (No Changes) ================= -->
<ScrollView android:id="@+id/tabHome" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"><TextView android:text="Text-to-Audio Generator" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"/><EditText android:id="@+id/editAudioText" android:layout_width="match_parent" android:layout_height="100dp" android:hint="Type text..." android:textColor="#FFFFFF"/><Button android:id="@+id/btnGenerateAudio" android:text="Generate Audio" android:layout_width="match_parent" android:layout_height="wrap_content"/><LinearLayout android:id="@+id/layoutAudioStatus" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="8dp"><TextView android:id="@+id/tvAudioStatus" android:text="Processing..." android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/><ProgressBar android:id="@+id/progressAudioGen" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"/></LinearLayout><LinearLayout android:id="@+id/layoutMediaControls" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="8dp"><Button android:id="@+id/btnRewind" android:text="-10s" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btnPlayPauseAudio" android:text="▶ Play" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/><Button android:id="@+id/btnFastForward" android:text="+10s" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout><LinearLayout android:id="@+id/layoutExportControls" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="8dp"><Button android:id="@+id/btnShareAudio" android:text="Share" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btnSaveAudio" android:text="SAVE AUDIO" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/></LinearLayout><Switch android:id="@+id/switchSilentMode" android:text="Respect Silent Mode" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"/><TextView android:text="--- Battery Announcer ---" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textStyle="bold"/><Switch android:id="@+id/switchBattery" android:text="Enable Battery Announcer" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><Switch android:id="@+id/switchCharger" android:text="Announce Charger Connected/Disconnected" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><Switch android:id="@+id/switchBatteryAlerts" android:text="Announce Battery Low (20%) &amp; Full" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Battery Announcement Interval:" android:textColor="#B0BEC5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/><Spinner android:id="@+id/spinnerBatteryInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><Button android:id="@+id/btnPreviewBattery" android:text="TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btnSaveBattery" android:text="SAVE SETTINGS" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/></LinearLayout><TextView android:text="--- Time Announcer ---" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textStyle="bold"/><Switch android:id="@+id/switchTime" android:text="Enable Time Announcer" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Time Format Setup:" android:textColor="#B0BEC5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/><Spinner android:id="@+id/spinnerTimeFormat" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/><TextView android:text="Time Announcement Interval:" android:textColor="#B0BEC5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/><Spinner android:id="@+id/spinnerTimeInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><Button android:id="@+id/btnPreviewTime" android:text="TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btnSaveTime" android:text="SAVE SETTINGS" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/></LinearLayout><TextView android:text="--- Call Announcer ---" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textStyle="bold"/><Switch android:id="@+id/switchCall" android:text="Enable Call Announcer" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Caller ID Announcement Format:" android:textColor="#B0BEC5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/><Spinner android:id="@+id/spinnerCallFormat" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/><TextView android:text="Repeat Call Announcement:" android:textColor="#B0BEC5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/><Spinner android:id="@+id/spinnerCallRepeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><Button android:id="@+id/btnPreviewCall" android:text="TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btnSaveCall" android:text="SAVE SETTINGS" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/></LinearLayout></LinearLayout></ScrollView>
<!-- ================= 2. MODES TAB (NEW Auto TTS UI) ================= -->
<ScrollView android:id="@+id/tabModes" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <TextView android:text="Modes" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <RadioGroup android:id="@+id/radioGroupModes" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/radioModeNone" android:text="None\nDisable language detection." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp"/>
            <RadioButton android:id="@+id/radioModeAuto" android:text="Auto language detect\nWhole-sentence language recognition. Reads text by most appropriated language." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp"/>
            <RadioButton android:id="@+id/radioModeDual" android:text="Dual languages\nReads Latin words by English, others by user-specified language." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp"/>
            <RadioButton android:id="@+id/radioModeMixed" android:text="Mixed mode\nSplits text into Latin and non-Latin segments, detects and reads each by the most appropriate language." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp"/>
            <RadioButton android:id="@+id/radioModeMulti" android:text="Multilingual mode (experimental)\nSplits text into per-language segments, detects and reads each." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="16dp"/>
        </RadioGroup>
        
        <TextView android:text="Mode Settings" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp"/>
        <TextView android:text="Preferred language for Latin text" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerLatinLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        <TextView android:text="Preferred language for non-Latin text" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerNonLatinLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        <TextView android:text="Select language for reading numbers:" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerNumberLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        <TextView android:text="Select language for reading punctuations:" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerPunctuationLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        <TextView android:text="Select language for reading emojis:" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerEmojiLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        
        <TextView android:text="Other options" android:textColor="#B0BEC5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
        <CheckBox android:id="@+id/chkMultiLocaleSpans" android:text="Supports multilingual text with locale spans" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
<!-- ================= 3. LANGUAGES TAB (NEW Auto TTS UI) ================= -->
<ScrollView android:id="@+id/tabLanguages" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Languages" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="#1E1E1E"/>
        <TextView android:text="Select languages you want to work with.\nNote: This list only includes languages supported by TTS engines on your device." android:textColor="#B0BEC5" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:gravity="center">
            <Button android:id="@+id/btnSelectAllLangs" android:text="SELECT ALL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:backgroundTint="#424242" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnClearAllLangs" android:text="CLEAR ALL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:backgroundTint="#424242" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnShowSelectedLangs" android:text="SHOW SELECTED" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:backgroundTint="#424242" android:textColor="#FFFFFF"/>
        </LinearLayout>
        <EditText android:id="@+id/edtSearchLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search..." android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:layout_margin="16dp" android:drawableStart="@android:drawable/ic_menu_search"/>
        <LinearLayout android:id="@+id/layoutLanguagesList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp"/>
    </LinearLayout>
</ScrollView>
<!-- ================= 4. VOICES TAB (NEW Auto TTS UI) ================= -->
<ScrollView android:id="@+id/tabVoices" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <TextView android:text="Voices" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp"/>
        <TextView android:text="Choose an installed voice for each language.\nTip: To avoid switching delays, we recommend assigning only one engine per language." android:textColor="#B0BEC5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        
        <TextView android:text="Select language" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
        <Spinner android:id="@+id/spinnerVoiceLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        <TextView android:text="Choose a voice for language" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerVoiceEngine" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        <TextView android:text="Choose a variant for voice" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerVoiceVariant" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#FFFFFF"/>
        
        <Button android:id="@+id/btnTestVoiceSingle" android:text="TEST" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:backgroundTint="#424242" android:textColor="#B0BEC5"/>
        
        <TextView android:text="Speed" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/btnSpeedMinus" android:text="-" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="#424242"/>
            <SeekBar android:id="@+id/seekVoiceRate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:progress="50" android:progressTint="#80CBC4" android:thumbTint="#80CBC4"/>
            <Button android:id="@+id/btnSpeedPlus" android:text="+" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="#424242"/>
        </LinearLayout>
        
        <TextView android:text="Volume" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/btnVolMinus" android:text="-" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="#424242"/>
            <SeekBar android:id="@+id/seekVoiceVolume" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:progress="100" android:progressTint="#80CBC4" android:thumbTint="#80CBC4"/>
            <Button android:id="@+id/btnVolPlus" android:text="+" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="#424242"/>
        </LinearLayout>

        <TextView android:text="Pitch" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/btnPitchMinus" android:text="-" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="#424242"/>
            <SeekBar android:id="@+id/seekVoicePitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:progress="50" android:progressTint="#80CBC4" android:thumbTint="#80CBC4"/>
            <Button android:id="@+id/btnPitchPlus" android:text="+" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="#424242"/>
        </LinearLayout>
        
        <Button android:id="@+id/btnDefaultVoice" android:text="DEFAULT" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="16dp" android:backgroundTint="#424242" android:textColor="#FFFFFF"/>
        
        <TextView android:text="Experimental" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"/>
        <CheckBox android:id="@+id/chkDedicatedEngines" android:text="Dedicated engines\nOnly use this option if you have a dedicated TTS engine for each voice..." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
<!-- ================= 5. ADVANCED TAB (NEW Auto TTS UI) ================= -->
<ScrollView android:id="@+id/tabAdvanced" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <TextView android:text="Text-to-Speech Settings" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp"/>
        <Button android:id="@+id/btnOpenSystemTts" android:text="TTS SETTINGS" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:backgroundTint="#424242" android:textColor="#FFFFFF"/>
        <TextView android:text="Open the system Text-to-Speech (TTS) settings screen" android:textColor="#B0BEC5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>
        
        <TextView android:text="Advanced Synthesis Options" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp"/>
        <TextView android:text="On certain devices, the accessibility audio stream is strictly restricted..." android:textColor="#B0BEC5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <CheckBox android:id="@+id/chkRemoveAudioAttr" android:text="Remove audio attributes from synthesis request.\nStrip audio attributes when sending synthesis requests to third-party TTS engines." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <CheckBox android:id="@+id/chkForceA11yStream" android:text="Force to use audio accessibility stream\nRoute TTS audio output through the accessibility audio stream." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        
        <TextView android:text="Keep-alive Mode" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp" android:layout_marginTop="16dp"/>
        <CheckBox android:id="@+id/chkKeepAlive" android:text="Keep alive\nEnabling this option prevents interruptions to third-party TTS engines." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        
        <TextView android:text="Persistence Options" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp" android:layout_marginTop="16dp"/>
        <CheckBox android:id="@+id/chkPersistentNotif" android:text="Show persistent notification\nUse a foreground service and to keep Auto TTS running during battery optimization or screen-off states." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnDisableBatteryOpt" android:text="DISABLE BATTERY OPTIMIZATION" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#424242" android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>
        <TextView android:text="Request battery optimization exemptions for both Auto TTS and all associated third-party TTS engines..." android:textColor="#B0BEC5" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        
        <TextView android:text="Language Detection Options" android:textColor="#82B1FF" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:padding="8dp" android:layout_marginTop="16dp"/>
        <CheckBox android:id="@+id/chkDisableAdvLangDetect" android:text="Disable advanced language detection\nTurn off advanced language detection for better performance." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <CheckBox android:id="@+id/chkQuickCharRead" android:text="Quick character read\nReads a single character based on the preferred language in the mode settings." android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <CheckBox android:id="@+id/chkReadPunctuationFlow" android:text="Read punctuation in flow with text" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
