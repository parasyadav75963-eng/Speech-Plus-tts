<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#121212">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:background="#1E1E1E">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Speech Plus TTS" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/btnNotificationCenter" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_popup_reminder" android:tint="#00E676" android:background="?attr/selectableItemBackground"/>
        <ImageButton android:id="@+id/btnVoiceSearch" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_btn_speak_now" android:tint="#FFFFFF" android:background="?attr/selectableItemBackground"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
        <EditText android:id="@+id/edtSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Search..." android:textColor="#FFFFFF"/>
        <ImageButton android:id="@+id/btnClearSearch" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:visibility="gone"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#2C2C2C">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp">
            <Button android:id="@+id/btnTabHome" android:text="Home" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#00E676" android:textColor="#FFFFFF" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnTabModes" android:text="Modes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnTabLanguages" android:text="Languages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnTabVoices" android:text="Voices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnTabAdvanced" android:text="Advanced" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#455A64" android:textColor="#B0BEC5" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnTabMore" android:text="More" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#455A64" android:textColor="#B0BEC5"/>
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <!-- 1. HOME TAB -->
        <ScrollView android:id="@+id/tabHome" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                                <TextView android:text="Text-to-Audio Generator" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"/>
                <EditText android:id="@+id/editAudioText" android:layout_width="match_parent" android:layout_height="100dp" android:hint="Type text..." android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnGenerateAudio" android:text="Generate Audio" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:id="@+id/layoutAudioStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                    <ProgressBar android:id="@+id/progressAudioGen" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvAudioStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutMediaControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                    <Button android:id="@+id/btnRewind" android:text="<<" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnPlayPauseAudio" android:text="Play" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnFastForward" android:text=">>" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutExportControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                    <Button android:id="@+id/btnShareAudio" android:text="Share" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnSaveAudio" android:text="Save" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                </LinearLayout>

                <Switch android:id="@+id/switchSilentMode" android:text="Respect Silent Mode" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
                
                <TextView android:text="--- Battery Announcer ---" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
                <Switch android:id="@+id/switchBattery" android:text="Enable Battery Announcer" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Switch android:id="@+id/switchCharger" android:text="Announce Charger Connected/Disconnected" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Switch android:id="@+id/switchBatteryAlerts" android:text="Announce Battery Low (20%) &amp; Full" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerBatteryInterval" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnPreviewBattery" android:text="TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnSaveBattery" android:text="SAVE SETTINGS" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/>
                </LinearLayout>

                <TextView android:text="--- Time Announcer ---" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
                <Switch android:id="@+id/switchTime" android:text="Enable Time Announcer" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerTimeFormat" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerTimeInterval" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnPreviewTime" android:text="TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnSaveTime" android:text="SAVE SETTINGS" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/>
                </LinearLayout>

                <TextView android:text="--- Call Announcer ---" android:textColor="#00E676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
                <Switch android:id="@+id/switchCall" android:text="Enable Call Announcer" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerCallFormat" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerCallRepeat" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnPreviewCall" android:text="TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnSaveCall" android:text="SAVE SETTINGS" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:backgroundTint="#6200EE" android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <!-- 2. MODES -->
        <ScrollView android:id="@+id/tabModes" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <RadioGroup android:id="@+id/radioGroupModes" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                <RadioButton android:id="@+id/radioMode0" android:text="Standard Mode" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/radioMode1" android:text="Fast Mode" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/radioMode2" android:text="Quality Mode" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </RadioGroup>
        </ScrollView>
        <!-- 3. LANGUAGES -->
        <ScrollView android:id="@+id/tabLanguages" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnSelectAllLangs" android:text="Select All" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnClearAllLangs" android:text="Clear All" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutLanguagesList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <!-- 4. VOICES -->
        <ScrollView android:id="@+id/tabVoices" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                <Spinner android:id="@+id/spinnerVoiceLanguage" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerVoiceEngine" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerVoiceVariant" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/lblVoicesRate" android:text="Rate" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnRateMinus" android:text="-" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <SeekBar android:id="@+id/seekVoiceRate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnRatePlus" android:text="+" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:id="@+id/lblVoicesPitch" android:text="Pitch" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnPitchMinus" android:text="-" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <SeekBar android:id="@+id/seekVoicePitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnPitchPlus" android:text="+" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:id="@+id/lblVoicesVolume" android:text="Volume" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <SeekBar android:id="@+id/seekVoiceVolume" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnTestVoiceSingle" android:text="Test" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnDefaultVoice" android:text="Reset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <Button android:id="@+id/btnSaveVoiceSettings" android:text="Save" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutConfiguredLanguages" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <!-- 5. ADVANCED -->
        <ScrollView android:id="@+id/tabAdvanced" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                <CheckBox android:id="@+id/chkForceRate" android:text="Force Rate" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <CheckBox android:id="@+id/chkForcePitch" android:text="Force Pitch" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <CheckBox android:id="@+id/chkStripAttributes" android:text="Strip Attributes" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnIgnoreBattery" android:text="Ignore Battery Optimizations" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerNumFormat" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerNumLang" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerPunctuation" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <!-- 6. MORE -->
        <ScrollView android:id="@+id/tabMore" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                <Button android:id="@+id/btnOpenSystemTts" android:text="Open System TTS Settings" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnOpenAboutPage" android:text="About App" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
