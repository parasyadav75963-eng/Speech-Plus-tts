<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Mode"
            android:textColor="#03DAC5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerModes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary Engine (Latin / English)"
            android:textColor="#03DAC5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEngines"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secondary Engine (Regional / Hindi)"
                android:textColor="#03DAC5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSecondaryEngines"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Routing Stream"
            android:textColor="#03DAC5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerAudioRouting"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/chkAmplifyVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amplify Speech Volume (Boost)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/chkKeepAlive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep-Alive Mode (Prevent background killing)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/chkForceRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force Speech Rate"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/chkForcePitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force Pitch"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/lblRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Rate: 1.00x"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/seekRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/lblPitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pitch: 1.00x"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/seekPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTestVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test Voice"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnStopSpeaking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMoreOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="More Options"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check for Updates"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
