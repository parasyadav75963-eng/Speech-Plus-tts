<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speech Plus TTS Hub" android:textColor="#00FF00" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="32dp"/>
        
        <Button android:id="@+id/btnOpenSmartReader" android:layout_width="match_parent" android:layout_height="60dp" android:text="Open Smart Reader" android:backgroundTint="#6200EA" android:textColor="#FFFFFF" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnTestVoiceSingle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test Voice Audio" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnPreviewCall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preview Call Announcer" android:layout_marginBottom="24dp"/>
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SETTINGS MODULES" android:textColor="#AAAAAA" android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnSettingsTimerBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Timer &amp; Battery Settings" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnSettingsSound" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sound &amp; Audio Settings" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnSettingsDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Display &amp; UI Settings" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnSettingsSmartReader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smart Reader Settings" android:layout_marginBottom="24dp"/>
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SYSTEM &amp; HELP" android:textColor="#AAAAAA" android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnOpenSystemTts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open System TTS Settings" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnJoinCommunity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Join ITFB Community" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnContactUs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contact Us" android:layout_marginBottom="32dp"/>
        
    </LinearLayout>
</ScrollView>
