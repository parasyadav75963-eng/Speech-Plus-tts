<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Navigation Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#1E1E1E"
        android:elevation="4dp">
                <LinearLayout
            android:id="@+id/tabsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView android:id="@+id/tabHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:padding="12dp" android:textColor="#B0BEC5" android:textSize="16sp" android:textStyle="bold" android:background="#2C2C2C" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tabModes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modes" android:padding="12dp" android:textColor="#B0BEC5" android:textSize="16sp" android:textStyle="bold" android:background="#2C2C2C" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tabLanguages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Languages" android:padding="12dp" android:textColor="#B0BEC5" android:textSize="16sp" android:textStyle="bold" android:background="#2C2C2C" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tabVoices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voices" android:padding="12dp" android:textColor="#B0BEC5" android:textSize="16sp" android:textStyle="bold" android:background="#2C2C2C" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tabAdvanced" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Advanced" android:padding="12dp" android:textColor="#B0BEC5" android:textSize="16sp" android:textStyle="bold" android:background="#2C2C2C" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tabMore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More" android:padding="12dp" android:textColor="#B0BEC5" android:textSize="16sp" android:textStyle="bold" android:background="#2C2C2C" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- 1. HOME TAB -->
        <ScrollView
            android:id="@+id/homeContentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Speech Plus TTS"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvAppInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Active | Dynamic Language Engine Loaded"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnNotificationCenter"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="🔔 Notifications"
                        android:textColor="#FFFFFF"
                        android:background="#2196F3"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="🔄 Updates"
                        android:textColor="#FFFFFF"
                        android:background="#9C27B0"
                        android:layout_marginStart="8dp" />
                </LinearLayout>


                <!-- SMART ANNOUNCER SETTINGS -->
                <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#607D8B" android:layout_marginVertical="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Announcers (Beta)"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Switch
                    android:id="@+id/switchSilentMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Respect Silent Mode"
                    android:textColor="#FF9800"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#424242" android:layout_marginVertical="8dp"/>

                <Switch
                    android:id="@+id/switchBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Battery Announcer"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery Announce Interval:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"/>
                <Spinner
                    android:id="@+id/spinnerBatteryInterval"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/battery_interval_options"
                    android:background="#333333"
                    android:layout_margin="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#424242" android:layout_marginVertical="8dp"/>

                <Switch
                    android:id="@+id/switchTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Time Announcer"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Format:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"/>
                <Spinner
                    android:id="@+id/spinnerTimeFormat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/time_format_options"
                    android:background="#333333"
                    android:layout_margin="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Announce Interval:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"/>
                <Spinner
                    android:id="@+id/spinnerTimeInterval"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/time_interval_options"
                    android:background="#333333"
                    android:layout_margin="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#424242" android:layout_marginVertical="8dp"/>

                <Switch
                    android:id="@+id/switchCall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Caller Name Announcer"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Announce Format:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"/>
                <Spinner
                    android:id="@+id/spinnerCallFormat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/call_format_options"
                    android:background="#333333"
                    android:layout_margin="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeat Count:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"/>
                <Spinner
                    android:id="@+id/spinnerCallRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/call_repeat_options"
                    android:background="#333333"
                    android:layout_margin="8dp" />

                <!-- TEXT-TO-AUDIO GENERATOR HUB -->
                <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#607D8B" android:layout_marginVertical="16dp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text-to-Audio Generator"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editAudioText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:hint="Type or paste text here to generate audio..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9E9E9E"
                    android:background="#333333"
                    android:padding="12dp"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnGenerateAudio"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="⚙️ Generate Audio"
                    android:textColor="#FFFFFF"
                    android:background="#00C853"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:id="@+id/layoutAudioStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:id="@+id/tvAudioStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Initializing..."
                        android:textColor="#FFEB3B"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />
                    <ProgressBar
                        android:id="@+id/progressAudioGen"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#00E676" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMediaControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">
                    <Button
                        android:id="@+id/btnRewind"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="⏪ 10s"
                        android:textColor="#FFFFFF"
                        android:background="#455A64"
                        android:layout_marginEnd="8dp" />
                    <Button
                        android:id="@+id/btnPlayPauseAudio"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="50dp"
                        android:text="▶ Play"
                        android:textColor="#FFFFFF"
                        android:background="#2196F3"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnFastForward"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="10s ⏩"
                        android:textColor="#FFFFFF"
                        android:background="#455A64"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutExportControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp">
                    <Button
                        android:id="@+id/btnShareAudio"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Share Audio"
                        android:textColor="#FFFFFF"
                        android:background="#9C27B0"
                        android:layout_marginEnd="8dp" />
                    <Button
                        android:id="@+id/btnSaveAudio"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Save to Device"
                        android:textColor="#FFFFFF"
                        android:background="#FF9800"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Placeholders for other tabs -->
        <ScrollView android:id="@+id/modesContentView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modes Tab" android:textColor="#FFF"/></ScrollView>
        <ScrollView android:id="@+id/languagesContentView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Languages Tab" android:textColor="#FFF"/></ScrollView>
        <ScrollView android:id="@+id/voicesContentView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voices Tab" android:textColor="#FFF"/></ScrollView>
        <ScrollView android:id="@+id/advancedContentView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Advanced Tab" android:textColor="#FFF"/></ScrollView>
        <ScrollView android:id="@+id/moreContentView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More Tab" android:textColor="#FFF"/></ScrollView>

    </FrameLayout>
</LinearLayout>
